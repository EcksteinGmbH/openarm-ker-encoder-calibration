# MODIFICATION NOTICE
# New file, not present in upstream OpenArm. Repository-wide ignores, so that
# rules which apply everywhere live in one place. M5/.gitignore and
# encoder/.gitignore are upstream's and stay as upstream wrote them; anything
# added by this fork belongs here.
#
# Deliberately NOT ignored: encoder/firmware/*.hex, which upstream tracks. A
# blanket build-output rule would be wrong here.
# ---------------------------------------------------------------------------

# --- assistant and editor tooling ------------------------------------------
.omc/
.claude/settings.local.json
.vscode/
.idea/
*.swp
*~

# --- Python ----------------------------------------------------------------
*venv/
__pycache__/
*.py[cod]

# --- build output ----------------------------------------------------------
.pio/
*.log

# --- OS --------------------------------------------------------------------
.DS_Store
Thumbs.db
